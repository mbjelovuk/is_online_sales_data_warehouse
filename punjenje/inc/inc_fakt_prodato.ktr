  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>eprodavnica_operativna</connection>
    <sql>SELECT
    s.IdArt,
    s.Iznos,
    s.Kolicina,
    n.IdKor          AS IdKorKupac,
    n.Datum,
    n.Vreme,
    a.IdKor          AS IdKorProdavac,
    a.IdKat,
    kk.IdMes         AS IdMesKupac,
    kp.IdMes         AS IdMesProdavac,
    kk.Pol           AS PolKupac,
    kp.Pol           AS PolProdavac,
    CAST(LEFT(CURRENT_DATE(), 4) AS SIGNED) - kk.Godiste AS UzrastKupac,
    CAST(LEFT(CURRENT_DATE(), 4) AS SIGNED) - kp.Godiste AS UzrastProdavac
FROM stavka s
INNER JOIN narudzbina n ON s.IdNar = n.IdNar
INNER JOIN artikal a ON s.IdArt = a.IdArt
INNER JOIN korisnik kk ON n.IdKor = kk.IdKor
INNER JOIN korisnik kp ON a.IdKor = kp.IdKor
WHERE CONCAT(n.Datum, ' ', n.Vreme) > '${posl_punj}'</sql>
    <limit>0</limit>
    <lookup/>
