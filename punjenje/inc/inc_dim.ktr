    <connection>eprodavnica_operativna</connection>
    <sql>SELECT IdArt, Naziv, Opis  
FROM artikal  
WHERE (  IdArt > (SELECT MAX(IdArt) 
				  FROM eprodavnica_skladiste.artikal_dim))</sql>
    <limit>0</limit>
