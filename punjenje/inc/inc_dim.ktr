  <step>
    <name>Table input kupac</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>eprodavnica_operativna</connection>
    <sql>SELECT DISTINCT k.IdKor AS IdKupac,  
       k.Pol,  
       CAST(LEFT(CURRENT_DATE(), 4) AS SIGNED) - k.Godiste AS Uzrast  
FROM korisnik k  
INNER JOIN narudzbina n ON k.IdKor = n.IdKor  
WHERE CONCAT(n.Datum, ' ', n.Vreme) > '${posl_punj}'  
UNION  
SELECT DISTINCT k.IdKor AS IdKupac,  
       k.Pol,  
       CAST(LEFT(CURRENT_DATE(), 4) AS SIGNED) - k.Godiste AS Uzrast  
FROM korisnik k  
INNER JOIN recenzija r ON k.IdKor = r.IdKor  
WHERE CONCAT(r.Datum, ' ', r.Vreme) > '${posl_punj}'</sql>
